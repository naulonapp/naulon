# What never ships to wordpress.org. The release zip is source minus development scaffolding —
# tests, tooling and VCS metadata are for this repository, not for a publisher's server.
/.git
/.gitignore
/.distignore
/.wp-env.json
/.phpunit.result.cache
/tests
/bin
/vendor
/composer.json
/composer.lock
/phpunit.xml.dist
/phpunit-integration.xml.dist

# wordpress.org listing assets live in SVN /assets, never in the plugin itself.
/.wordpress-org
/languages/*.po

# The GitHub self-updater. A plugin hosted on wordpress.org may not serve its own updates
# (Plugin Guideline 8), and does not need to — the directory does it. One zip serves both
# channels, so excluding it here means no install carries it, not just the .org one: nothing
# requires the class and the plugin declares no `Update URI`, so it would be dead weight a
# reviewer greps for anyway. It stays in the repository, unloaded, so the mechanism can be
# restored in one commit if the listing is refused.
/includes/class-naulon-updater.php

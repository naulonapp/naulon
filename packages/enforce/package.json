{
  "name": "@naulon/enforce",
  "version": "0.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naulonapp/naulon.git",
    "directory": "packages/enforce"
  },
  "description": "Runtime-agnostic naulon toll-decision kernel + in-app enforcement middleware. The neutral low-level core shared by @naulon/tollgate (the gate) and @naulon/sdk (the publisher SDK) \u2014 no dependency cycle.",
  "keywords": [
    "x402",
    "usdc",
    "paywall",
    "ai-crawler",
    "bot-detection",
    "middleware",
    "micropayments",
    "naulon"
  ],
  "homepage": "https://naulon.app",
  "bugs": {
    "url": "https://github.com/naulonapp/naulon/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/enforce/next.d.ts",
      "import": "./dist/enforce/next.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@naulon/sdk": "^0.4.0",
    "@naulon/shared": "^0.4.0",
    "viem": "^2.56.0"
  },
  "peerDependencies": {
    "next": ">=15"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}

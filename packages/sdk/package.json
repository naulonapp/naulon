{
  "name": "@naulon/sdk",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naulonapp/naulon.git",
    "directory": "packages/sdk"
  },
  "description": "The naulon publisher contract: credits + settlement wire types, validators, HMAC sign/verify, and credits resolvers. One source of truth for the money-routing trust boundary.",
  "keywords": [
    "x402",
    "usdc",
    "micropayments",
    "paywall",
    "ai-crawler",
    "citation",
    "stablecoin",
    "naulon",
    "rsl",
    "content-licensing"
  ],
  "homepage": "https://naulon.app",
  "bugs": {
    "url": "https://github.com/naulonapp/naulon/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "import": "./dist/express/index.js"
    },
    "./cli": {
      "types": "./dist/cli/check.d.ts",
      "import": "./dist/cli/check.js"
    },
    "./slug": {
      "types": "./dist/contract/slug.d.ts",
      "import": "./dist/contract/slug.js"
    },
    "./rsl": {
      "types": "./dist/rsl/index.d.ts",
      "import": "./dist/rsl/index.js"
    },
    "./net": {
      "types": "./dist/crawl/net.d.ts",
      "import": "./dist/crawl/net.js"
    },
    "./crawl": {
      "types": "./dist/crawl/index.d.ts",
      "import": "./dist/crawl/index.js"
    },
    "./crawl/testing": {
      "types": "./dist/crawl/testing.d.ts",
      "import": "./dist/crawl/testing.js"
    }
  },
  "bin": {
    "naulon": "./dist/cli/naulon.js",
    "naulon-kit": "./dist/cli/naulon.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.7",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "express": ">=4",
    "next": ">=15"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.2.1"
  }
}
